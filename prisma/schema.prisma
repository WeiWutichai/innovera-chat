generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id              String     @id @default(cuid())
  clerkUserId     String     @unique
  email           String     @unique
  name            String?
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING)
  dailyTokenLimit Int        @default(50000)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  conversations Conversation[]
  usages        Usage[]
  files         File[]
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  files    ConversationFile[]

  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  promptTokens   Int?
  outputTokens   Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Usage {
  id               String   @id @default(cuid())
  userId           String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  requestCount     Int      @default(1)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Serves the daily-quota aggregate (sum totalTokens where userId + createdAt >= dayStart),
  // which runs on every chat request. The former standalone @@index([userId]) was a strict
  // left-prefix of this composite and has been dropped as redundant.
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum FileExtractStatus {
  // Queued, not yet claimed.
  PENDING
  // Claimed by a worker. Carries a lease so a crash cannot strand it here forever.
  PROCESSING
  // Terminal states.
  EXTRACTED
  PARTIAL
  UNSUPPORTED
  FAILED
  // M1 legacy: uploaded before extraction existed. Never re-processed automatically, so
  // an M1 file is never silently reinterpreted by a later milestone's parser.
  SKIPPED
}

model File {
  id     String @id @default(cuid())
  userId String

  // Server-generated, opaque, and never derived from the uploaded filename. Unique so a
  // key collision surfaces as a constraint violation rather than a silent overwrite of
  // another user's bytes.
  storageKey String @unique

  // Display only. Sanitised on write; never used to build a filesystem path.
  filename String

  // Sniffed from the bytes, never taken from the client's Content-Type header.
  mimeType String

  sizeBytes Int
  checksum  String

  // M1 stores and serves; it never parses. SKIPPED records that decision explicitly so
  // a later extraction milestone can find the backlog, and so the UI can state plainly
  // that content was not read rather than implying an empty result.
  // New uploads queue for extraction. Files created under M1 keep SKIPPED.
  extractStatus FileExtractStatus @default(PENDING)

  // Short, classified and user-safe. Never a stack trace or a library message.
  extractReason String?

  // Bounded at write time by LIMITS.maxChars.
  extractedText    String?
  // Character count BEFORE truncation, so accounting stays honest.
  extractedChars   Int?
  extractTruncated Boolean @default(false)

  // Pages / sheets / slides, and parser-reported scalars. Never file content.
  extractUnits    Json?
  extractMetadata Json?

  extractedAt DateTime?

  // Lease held by the worker currently processing this row. A row whose lease has
  // expired is provably abandoned — the holder crashed or was restarted — and may be
  // reclaimed. Without it, a crash mid-extraction strands a row in PROCESSING forever.
  extractLeaseUntil DateTime?
  extractAttempts   Int       @default(0)

  createdAt DateTime @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations ConversationFile[]

  // Serves the owner-scoped list (the only read path in M1) and the quota aggregate.
  @@index([userId, createdAt])
  // Serves the worker's claim query: PENDING rows, or PROCESSING rows whose lease has
  // expired. Without it that scan grows with the whole table.
  @@index([extractStatus, extractLeaseUntil])
}

/**
 * Attaches an already-uploaded File to a Conversation.
 * A JOIN ROW ONLY — it carries no content and no copy of the blob. The same File may be
 * attached to several conversations, which is the point: re-asking about a document must
 * not mean re-uploading it, and must not consume the storage quota twice.
 * OWNERSHIP IS NOT EXPRESSED HERE, AND THAT IS DELIBERATE.
 * There is no userId column. A join row that carried its own userId could disagree with
 * the two rows it points at, and the disagreement would be invisible. Instead both sides
 * are re-checked against the authenticated user on every write (see
 * src/lib/ai/context/attachments.ts) — the database enforces existence and uniqueness,
 * the service enforces ownership.
 * LIFECYCLE
 * detach a file from a conversation -> this row is deleted, the File is untouched
 * delete the Conversation           -> cascade removes its rows, Files are untouched
 * delete the File                   -> cascade removes its rows, Conversations and
 * their Messages are untouched
 * Cascade rather than service logic for the two deletes: the join row is meaningless
 * without either endpoint, so a dangling row is never the correct outcome, and enforcing
 * that in the schema means it holds for restores and manual SQL too.
 */
model ConversationFile {
  conversationId String
  fileId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  // Composite primary key IS the uniqueness constraint: attaching the same file twice
  // is idempotent rather than an error, and no surrogate id can drift from it.
  @@id([conversationId, fileId])
  // Serves the reverse lookup used when a File is deleted or listed.
  @@index([fileId])
}
