#!/usr/bin/env bash
#
# Refuses any push to the production remote.
#
# This is the SECOND layer of protection, not the first. The primary safeguard is
# `remote.production.pushurl = DISABLED`, which makes a push fail before any network
# call. This hook exists because that setting is local config: a fresh clone, a reset
# .git/config, or a re-added remote would silently lose it, while this file is versioned
# and travels with the repository.
#
# Enable in a fresh clone with:
#     git config core.hooksPath .githooks
#
# Deliberately matches on the remote NAME only. It contains no host, no credential and
# no production identifier, so it is safe to commit.
#
# Emergency override (deliberate, deploy-time only):
#     ALLOW_PRODUCTION_PUSH=1 git push production <ref>

set -euo pipefail

remote_name="${1:-}"

if [ "${remote_name}" = "production" ]; then
  if [ "${ALLOW_PRODUCTION_PUSH:-}" = "1" ]; then
    echo "pre-push: ALLOW_PRODUCTION_PUSH=1 set — permitting push to '${remote_name}'." >&2
    exit 0
  fi

  cat >&2 <<'MESSAGE'
pre-push: REFUSED.

This push targets the "production" remote. Development pushes belong on "origin"
(GitHub). Deploying is a separate, approved procedure — not a git push.

If you genuinely intend to push to production, this must be a deliberate act:
    ALLOW_PRODUCTION_PUSH=1 git push production <ref>

Note that remote.production.pushurl is also set to DISABLED, so the push will still
fail at the transport layer until that is changed too.
MESSAGE
  exit 1
fi

exit 0
